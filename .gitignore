# Godot 4+ specific ignores
.godot/
/android/

# MCP dev-addon (godot-mcp-pro free plugin) -- a dev-only editor tool, not
# game content. Re-obtained on a fresh clone per README.md and never
# committed. (project.godot's autoload/enabled-plugin refs to it are also
# stripped from commits automatically -- see tools/strip-mcp-refs.py.)
/addons/godot_mcp/

# Export presets can embed signing/keystore secrets -- never commit.
export_presets.cfg

# Build/export output
/build/

# OS / editor cruft
*.tmp
.DS_Store
Thumbs.db
desktop.ini

# C#/.NET generated.
.mono/
data_*/
mono_crash.*
/obj/
/bin/
*.user
.vs/

# Copyrighted game-transcription MIDI test assets -- not ours to redistribute.
# The SF2 soundfont in audio/ is public domain and stays committed.
/audio/*.mid

# .NET build output (library + test projects under src/ and tests/).
[Bb]in/
[Oo]bj/
[Tt]est[Rr]esults/

# NOTE: *.import files are intentionally NOT ignored -- Godot needs them
# committed for reproducible imports.
